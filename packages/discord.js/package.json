{
  "name": "@arx.js/discord.js",
  "version": "1.0.0-alpha.2",
  "description": "Developer-friendly ARX client on top of discord.js with the same command framework and safe cache defaults.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@arx.js/discord": "1.0.0-alpha.2",
    "discord.js": "^14.27.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2"
  }
}
